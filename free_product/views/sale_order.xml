<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="free_product_view" model="ir.ui.view">
       <field name="name">free.product.view</field>
       <field name="model">sale.order</field>
       <field name="inherit_id" ref="sale.view_order_form"/>
       <field name="arch" type="xml">

           <xpath expr="//header" position="inside">
               <button name="action_free" string="Add Free Product" type="object" class="oe_highlight"/>
           </xpath>
           <xpath expr="//field[@name='partner_id']" position="after">
               <field name="exclude_product_ids" widget="many2many_tags"/>
           </xpath>
       </field>
   </record>
</odoo>