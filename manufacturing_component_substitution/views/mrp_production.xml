<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="manufacturing_order_form_view" model="ir.ui.view">
       <field name="name">manufacturing.order.form.viem</field>
       <field name="model">mrp.production</field>
       <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
       <field name="arch" type="xml">
           <xpath expr="//header" position="inside">
                <button name="action_alternate" type="object" class="btn btn-primary"
                        string="Suggest Alternate Product" invisible="not is_alternate_required"/>
            </xpath>
           <xpath expr="//field[@name='user_id']" position="after">
                <field name="is_alternate_required"/>
            </xpath>
       </field>
   </record>
</odoo>