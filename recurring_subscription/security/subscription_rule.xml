<odoo>
    <data>
        <record model="ir.rule" id="subscription_restricted_company_rule">
            <field name="name">Restricted subscription Record: multi-company</field>
            <field name="model_id" ref="model_recurring_subscription"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                    [('company_id', 'in', company_ids)]
            </field>
        </record>
        <record model="ir.rule" id="billing_restricted_company_rule">
            <field name="name">Restricted billing Record: multi-company</field>
            <field name="model_id" ref="model_billing_schedule"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                    [('company_id', 'in', company_ids)]
            </field>
        </record>
        <record model="ir.rule" id="credit_restricted_company_rule">
            <field name="name">Restricted credit Record: multi-company</field>
            <field name="model_id" ref="model_recurring_credit"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                    [('company_id', 'in', company_ids)]
            </field>
        </record>
        <record model="ir.rule" id="partner_restricted_company_rule">
            <field name="name">Restricted partner Record: multi-company</field>
            <field name="model_id" ref="model_partner_account"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                    [('company_id', 'in', company_ids)]
            </field>
        </record>
    </data>
</odoo>

