<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="page_credit_sub"
                  name="Subscription Credit Page">
            <t t-call="website.layout">
                <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001" data-snippet="s_title" data-scroll-background-ratio="1">
                        <span class="s_parallax_bg oe_img_bg" style="background-image: url('/web/image/website.s_parallax_default_image'); background-position: 50% 0;"/>
                        <div class="o_we_bg_filter bg-black-50"/>
                        <div class="container">
                            <h1>Subscription Credit</h1>
                        </div>
                    </section>
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-md-6 col-lg-5">
                            <p class="lead text-center">
                                Hello,<t t-esc="user_name"/>! create your
                                subscription credit here!.
                            </p>
                            <div class="card shadow rounded-3 border-0">
                                <div class="card-body p-4">
                                    <h3 class="text-muted text-center">Create New Credit</h3>
                                    <form method="post" action="/credit-create">

                                        <br></br>

                                        <label for="cred2" class="form-label">Recurring Subscription</label>
                                        <select id="cred2" name="rec_sub_id" class="form-control" required="">
                                            <option value=""></option>
                                            <option
                                                    t-foreach="subscriptions"
                                                    t-as="subscription"
                                                    t-att-value="subscription.id"
                                                    t-out="subscription.order_seq"/>
                                        </select>


                                        <br></br>
                                        <br></br>

                                        <label for="cred3" class="form-label">Period</label>
                                        <input type="date" id="cred3" class="form-control" name="period" required=""/>

                                        <br></br>
                                        <br></br>

                                        <label for="cred4" class="form-label">Credit Amount $</label>
                                        <input type="number" name="credit_amount" class="form-control" id="cred4" required=""/>

                                        <br></br>
                                        <br></br>

                                        <input type="submit" value="Submit" formaction="/credit-create" class="btn btn-primary"/>

                                        <br></br>
                                        <br></br>

                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </t>
        </template>

        <template id="page_credit_success" name="Credit Success Page">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure">
                    <div class="container">
                        <div class="row">

                            <div class="col-12 text-center mt-5">
                                <p>Your Credit Form Successfully Submitted!</p>
                                <br></br>
                                <br></br>
                                <a href="/credit-odoo" role="button">Back to
                                    create page
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            </t>
        </template>
        <record id="credit_menu" model="website.menu">
            <field name="name">Subscription Credit</field>
            <field name="url">/credit-odoo</field>
            <field name="parent_id" ref="website.main_menu"/>
        </record>
    </data>
</odoo>
