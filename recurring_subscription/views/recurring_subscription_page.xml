        <template id="page_subscription_success"
                  name="Recurring Subscription Page">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure">
                    <div class="container">
                        <div class="row">

                            <div class="col-12 text-center mt-5">
                                <p>Your Form Successfully Submitted!</p>
                                <br></br>
                                <br></br>
                                <a href="/recurring-odoo" role="button">Back to
                                    create page
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            </t>
        </template>


        <record id="recurring_menu" model="website.menu">
            <field name="name">Recurring Subscription</field>
            <field name="url">/recurring-odoo</field>
            <field name="parent_id" ref="website.main_menu"/>
        </record>
    </data>
</odoo>
