<odoo>
    <record id="view_sub_report_form" model="ir.ui.view">
        <field name="name">view.sub.report.form</field>
        <field name="model">recurring.subscription.report</field>
        <field name="arch" type="xml">
            <form string="report">
                <group>
                    <field name="subscription_ids" widget="many2many_tags"/>
                    <field name="report_type"/>
                </group>
                <footer>
                    <button name="action_sub_report"
                            string="Print PDF"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_print_xlsx" string="Print XLSX"
                            type="object" class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pdf" model="ir.actions.act_window">
        <field name="name">Subscription Report</field>
        <field name="res_model">recurring.subscription.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
