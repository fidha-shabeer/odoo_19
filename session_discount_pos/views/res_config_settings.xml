<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="res_config_settings_view_form_inherit_pos" model="ir.ui.view">
       <field name="name">res.config.settings.view.form.inherit.pos</field>
       <field name="model">res.config.settings</field>
       <field name="inherit_id" ref="pos_restaurant.res_config_settings_view_form"/>
       <field name="arch" type="xml">
           <xpath expr="//block[@id='pos_inventory_section']" position="after">
               <block title="Session wise discount limit">
                   <setting string="Discount Limit" help="Set discount limit to apply for each sessions ">
                       <field name="max_discount_limit"/>
                   </setting>
               </block>
           </xpath>
       </field>
   </record>
</odoo>