<odoo>
    <record id="view_updated_price_form" model="ir.ui.view">
        <field name="name">view.updated.price.form</field>
        <field name="model">view.update.wizard</field>
        <field name="arch" type="xml">
            <form string="View Updated Price">
                <group>
                    <field name="product_ids" widget="many2many_tags"/>
                    <field name="percentage"/>
                    <field name="fixed_price"/>
                    <field name="updated_price"/>
                </group>
                <footer>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

