<odoo>
   <record id="view_qrcode_wizard_form" model="ir.ui.view">
       <field name="name">qrcode.wizard.form</field>
       <field name="model">qr.generate.wizard</field>
       <field name="arch" type="xml">
           <form string="Generate QR Code">
               <group>
                   <field name="text"/>
                   <field name="qr_code" widget="image" class="oe_avatar" readonly="1"/>
                   <field name="filename" invisible="1"/>
                   <field name="image" filename="filename"/>
                   <button string="Click To Save" type="object" name="action_download" class="btn-primary"/>
                   <button string="Generate PDF" type="object" name="action_pdf" class="btn-primary"/>
                   <button string="Reset" type="object" name="action_reset" class="btn-primary"/>
               </group>
           </form>
       </field>
   </record>
</odoo>