<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_history" model="ir.ui.view">
        <field name="name">purchase.history</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form/sheet/div[@name='button_box']"
                   position="inside">
                <button class="oe_stat_button"
                        type="object"
                        icon="fa-book"
                        name="action_history">
                    <field string="PO History" name="po_history"
                           widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>