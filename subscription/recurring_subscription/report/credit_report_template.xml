<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="credit_report_details">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="oe_structure"/>
                    <h2 class="text-center">Credit Report</h2>
                    <hr/>
                    <div class="row mb-4">
                        <div class="col-6">
                            <strong>Subscription:</strong>
                            <span t-esc="sub_id"/>
                        </div>
                        <div class="col-3">
                            <strong>Customer:</strong>
                            <t t-if="same_cust">
                                <span t-esc="docs.partner_id.name"/>
                            </t>
                        </div>
                        <div class="col-3">
                            <strong>State:</strong>
                            <span t-esc="credit_state"/>
                        </div>
                    </div>
                    <table class="table table-bordered table-sm">
                        <thead class="table-primary">
                            <tr>
                                <th>SL NO</th>
                                <th>Subscription</th>
                                    <t t-if="not same_cust">
                                        <th>Customer</th>
                                    </t>
                                <th>Amount Applied</th>
                                <th>Amount Pending</th>
                                <th>State</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="credit">
                                <tr>
                                    <td>
                                        <span t-esc="credit_index + 1"/>
                                    </td>
                                    <td>
                                        <span t-field="credit.recurring_sub_id.order_seq"/>
                                    </td>
                                    <td t-if="not same_cust">
                                        <span t-field="credit.partner_id.name"/>
                                    </td>
                                    <td>
                                        <span t-field="credit.recurring_amounts"/>
                                    </td>
                                    <td>
                                        <span t-esc="credit.recurring_amounts - credit.credit_amounts"/>
                                    </td>
                                    <td>
                                        <span t-esc="credit_state"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div class="mt-3">
                        <strong>Total Credits:</strong>
                        <span t-esc="len(docs)"/>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>