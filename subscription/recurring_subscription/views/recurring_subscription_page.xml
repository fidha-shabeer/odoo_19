<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="page_recurring_subscription"
                  name="Recurring Subscription Page">
            <t t-call="website.layout">
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-md-6 col-lg-5">
                            <div class="card shadow rounded-3 border-0">
                                <div class="card-body p-4">
                                    <h3 class="mb-4 text-center">Create New
                                        Customer
                                    </h3>
                                    <form action="/subscription-create" method="post">
                                        <br></br>

                                        <label for="sub3">Partner</label>
                                        <select id="sub3" name="partner_id" required="">
                                            <option value=""></option>
                                            <option
                                                    t-foreach="partners"
                                                    t-as="partner"
                                                    t-att-value="partner.id"
                                                    t-out="partner.name"/>
                                        </select>

                                        <br></br>
                                        <br></br>

                                        <label for="sub2">Establishment ID
                                        </label>
                                        <input type="text" id="sub2"
                                               name="establishment_id" required=""/>

                                        <br></br>
                                        <br></br>

                                        <label class="col-form-label"
                                               for="sub3">Product
                                        </label>
                                        <select id="sub3" name="product_id" required="">
                                            <option value=""></option>
                                            <option
                                                    t-foreach="products"
                                                    t-as="product"
                                                    t-att-value="product.id"
                                                    t-out="product.display_name"/>
                                        </select>

                                        <br></br>
                                        <br></br>

                                        <label for="sub4">Date</label>
                                        <input type="date" id="sub4"
                                               name="date" required=""/>

                                        <br></br>
                                        <br></br>

                                        <label for="sub5">Recurring Amount $
                                        </label>
                                        <input type="number"
                                               name="recurring_amount"
                                               id="sub5" required=""/>

                                        <br></br>
                                        <br></br>

                                        <label for="sub6">Is Lead</label>
                                        <input type="checkbox" checked="no" id="sub6" name="is_lead" />
                                        <br></br>
                                        <br></br>

                                        <input type="submit" value="Submit"
                                               class="btn btn-primary" formaction="/subscription-create"/>

                                        <br></br>
                                        <br></br>

                                    </form>
                               </div>
                            </div>
                        </div>
                    </div>
                </section>
            </t>
        </template>

        <template id="page_subscription_success" name="Recurring Subscription Page">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure">
                    <div class="container">
                        <div class="row">

                            <div class="col-12 text-center mt-5">
                                <p>Your Form Successfully Submitted!</p>
                                <br></br>
                                <br></br>
                                <a href="/recurring-odoo" role="button">Back to create page</a>
                             </div>

                        </div>
                    </div>
                </div>
            </t>
        </template>

        <record id="recurring_menu" model="website.menu">
            <field name="name">Recurring Subscription</field>
            <field name="url">/recurring-odoo</field>
            <field name="parent_id" ref="website.main_menu"/>
        </record>
    </data>
</odoo>

