<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="po_email_template" model="mail.template">
        <field name="name">PO Delay</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="subject">PO Delay</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="body_html" type="html">
            <div>
                <p>
                    <div style="margin: 0px; padding: 0px;">
                    <div style="justify-content: center;background-color: #714B67; padding:0.6rem;padding-left: 35px;text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;width:40%">
                        <h2>
                            Hi,
                            <t t-out="object.partner_id.name"/>
                        </h2>
                        <div>
                            <h3>
                                Purchase order <t t-out="object.name"/> is delayed!!
                            </h3>
                        </div>
                    </div>
                    <br/>
                    <br/>
                    Regards,
                    <br/>
                    <t t-out="object.company_id.name"/>
                    <br/>
                </div>
                </p>
            </div>
        </field>
    </record>
</odoo>