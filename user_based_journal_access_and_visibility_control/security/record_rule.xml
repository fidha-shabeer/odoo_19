<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.rule" id="account_journal_rule">
            <field name="name">Account Journal Rules</field>
            <field name="model_id" ref="model_account_journal"/>
            <field name="domain_force">[('journal_ids','=',user.journal_ids.ids),('user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>
    <record model="ir.rule" id="account_move_rule">
            <field name="name">Account Move Rules</field>
            <field name="model_id" ref="model_account_move"/>
            <field name="domain_force">[('journal_id','in',user.journal_ids.ids),('user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>
</odoo>