<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="crm_dashboard.CrmDashboard">
        <div style="overflow-y: scroll; height:1000px;">
            <div>
                <center>
                    <h1 style="margin:20px;">CRM Dashboard</h1>
                </center>

                <div class="row main-section" style="margin-left: 120px;">
                    <div>
                        <select class="form-select" t-on-change="onChangePeriod">
                            <option value="year">Year</option>
                            <option value="quarter">Quarter</option>
                            <option value="month">Month</option>
                            <option value="week">Week</option>
                            <option value="daily">Daily</option>
                        </select>
                    </div>
                    <!-- Lead Tile-->
                    <div id="leads" class="col-md-4 col-sm-6 tot_tasks oh-payslip"
                         style=" overflow: hidden; padding-top: 30px;">
                        <div class="oh-card" style="box-shadow:2px 4px 8px 2px rgba(0,0,0.3,0.2);
       display: flex; justify-content: center;" role="button" t-on-click="OpenLead">
                            <div class="oh-card-body"
                                 style="padding: 5px 5px; float: left; width: 100%;
                 height: auto; box-sizing: border-box; margin: 0;">
                                <div class="stat-widget-one">
                                    <div class="stat-icon bg-mauve-light d-flex justify-content-left align-items-left">
                                        <div style="background:#ff4d94; width:65px; text-align: center;">
                                            <i class="fa fa-tasks text-mauve"
                                               style="font-size:50px;"/>
                                        </div>
                                        <div class="stat_content" style="
                         text-align: center; font-weight: bold;
                         padding-top: 20px; padding-left: 80px;">
                                            <div class="stat_count_lead"
                                                 style="font-size: 17px;">
                                                <span id="templates">
                                                    <div id="my_lead"/>
                                                </span>
                                            </div>
                                            <div class="stat-head"
                                                 style="font-size: 14px;">My Leads
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Opportunity Tile-->
                    <div id="opportunity" class="col-md-4 col-sm-6 tot_tasks oh-payslip"
                         style=" overflow: hidden; padding-top: 30px;">
                        <div class="oh-card" style="box-shadow:2px 4px 8px 2px rgba(0,0,0.3,0.2);
       display: flex; justify-content: center;" role="button">
                            <div class="oh-card-body"
                                 style="padding: 5px 5px; float: left; width: 100%;
                 height: auto; box-sizing: border-box; margin: 0;">
                                <div class="stat-widget-one">
                                    <div class="stat-icon bg-mauve-light d-flex justify-content-left align-items-left">
                                        <div style="background:yellow; width:65px; text-align: center;">
                                            <i class="fa fa-trophy  text-mauve"
                                               style="font-size:50px;"/>
                                        </div>
                                        <div class="stat-content" style="
                         text-align: center; font-weight: bold;
                         padding-top: 20px; padding-left: 80px;">
                                            <div class="stat_count_opp"
                                                 style="font-size: 17px;">
                                                <span id="templates">
                                                    <div id="my_opportunity"/>
                                                </span>
                                            </div>
                                            <div class="stat-head"
                                                 style="font-size: 14px;">My Opportunity
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Expected Revenue -->
                    <div id="expected_revenue"
                         class="col-md-4 col-sm-6 tot_tasks oh-payslip"
                         style=" overflow: hidden; padding-top: 30px;">
                        <div class="oh-card" style="box-shadow:2px 4px 8px 2px rgba(0,0,0.3,0.2);
       display: flex; justify-content: center;" role="button">
                            <div class="oh-card-body"
                                 style="padding: 5px 5px; float: left; width: 100%;
                 height: auto; box-sizing: border-box; margin: 0;">
                                <div class="stat-widget-one">
                                    <div class="stat-icon bg-mauve-light d-flex justify-content-left align-items-left">
                                        <div style="background:#bf80ff;; width:65px; text-align: center;">
                                            <i class="fa fa-usd  text-mauve"
                                               style="font-size:50px;"/>
                                        </div>
                                        <div class="stat-content" style="
                         text-align: center; font-weight: bold;
                         padding-top: 20px; padding-left: 80px;">
                                            <div class="stat_count_ex_rev"
                                                 style="font-size: 17px;">
                                                <span id="templates">
                                                    <div id="my_expected_revenue"/>
                                                </span>
                                            </div>
                                            <div class="stat-head"
                                                 style="font-size: 14px;">Expected
                                                revenue
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="revenue"
                         class="col-md-4 col-sm-6 tot_tasks oh-payslip"
                         style=" overflow: hidden; padding-top: 30px;">
                        <div class="oh-card" style="box-shadow:2px 4px 8px 2px rgba(0,0,0.3,0.2);
       display: flex; justify-content: center;" role="button">
                            <div class="oh-card-body"
                                 style="padding: 5px 5px; float: left; width: 100%;
                 height: auto; box-sizing: border-box; margin: 0;">
                                <div class="stat-widget-one">
                                    <div class="stat-icon bg-mauve-light d-flex justify-content-left align-items-left">
                                        <div style="background:#ffe380;; width:65px; text-align: center;">
                                            <i class="fa fa-check  text-mauve"
                                               style="font-size:50px;"/>
                                        </div>
                                        <div class="stat-content" style="
                         text-align: center; font-weight: bold;
                         padding-top: 20px; padding-left: 80px;">
                                            <div class="stat_count_ex_rev"
                                                 style="font-size: 17px;">
                                                <span id="templates">
                                                    <div id="my_revenue"/>
                                                </span>
                                            </div>
                                            <div class="stat-head"
                                                 style="font-size: 14px;">Revenue
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="win_ratio"
                         class="col-md-4 col-sm-6 tot_tasks oh-payslip"
                         style=" overflow: hidden; padding-top: 30px;">
                        <div class="oh-card" style="box-shadow:2px 4px 8px 2px rgba(0,0,0.3,0.2);
       display: flex; justify-content: center;" role="button">
                            <div class="oh-card-body"
                                 style="padding: 5px 5px; float: left; width: 100%;
                 height: auto; box-sizing: border-box; margin: 0;">
                                <div class="stat-widget-one">
                                    <div class="stat-icon bg-mauve-light d-flex justify-content-left align-items-left">
                                        <div style="background:#b8dce0;; width:65px; text-align: center;">
                                            <i class="fa fa-thumbs-o-up  text-mauve"
                                               style="font-size:50px;"/>
                                        </div>
                                        <div class="stat-content" style="
                         text-align: center; font-weight: bold;
                         padding-top: 20px; padding-left: 80px;">
                                            <div class="stat_count_ex_rev"
                                                 style="font-size: 17px;">
                                                <span id="templates">
                                                    <div id="my_ratio"/>
                                                </span>
                                            </div>
                                            <div class="stat-head"
                                                 style="font-size: 14px;">Win Ratio
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row main-section" style="margin-left: 120px;">

                    <div class="col-md-4 col-sm-6 tot_tasks oh-payslip">
                        <div class="shadow-sm border m-2 p-4 bg-white">
                            <h3 class="text-primary fw-bold">Leads By Medium</h3>
                            <canvas t-ref="doughnut"/>
                        </div>
                    </div>


                    <div class="col-md-4 col-sm-6 tot_tasks oh-payslip">
                        <div class="shadow-sm border m-2 p-4 bg-white">
                            <h3 class="text-primary fw-bold">Activity Chart</h3>
                            <canvas t-ref="activityChart"/>
                        </div>
                    </div>


                    <div class="col-md-4 col-sm-6 tot_tasks oh-payslip">
                        <div class="shadow-sm border m-2 p-4 bg-white">
                            <h3 class="text-primary fw-bold">Leads By Month</h3>
                            <table class="table table-bordered table-sm">
                                <thead class="table-primary">
                                    <tr>
                                        <th>Months</th>
                                        <th>Lead Count</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.monthLead" t-as="lead" t-key="lead">
                                        <tr>
                                            <td>
                                                <t t-esc="lead.label"/>
                                            </td>
                                            <td>
                                                <t t-esc="lead.count"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="col-md-4 col-sm-6 tot_tasks oh-payslip">
                        <div class="shadow-sm border m-2 p-4 bg-white">
                            <h3 class="text-primary fw-bold">Lost Opportunity/Lead Graph</h3>
                            <canvas t-ref="chart"/>
                        </div>
                    </div>

                    <div class="col-md-4 col-sm-6 tot_tasks oh-payslip">
                        <div class="shadow-sm border m-2 p-4 bg-white">
                            <h3 class="text-primary fw-bold">Leads By Campaign</h3>
                            <canvas t-ref="line"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>