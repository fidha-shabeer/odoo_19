<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_revision_form_view" model="ir.ui.view">
        <field name="name">sale.order.revision.form.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/div[@name='button_box']"
                   position="inside">
                <button class="oe_stat_button"
                        type="object"
                        icon="fa-book"
                        name="action_sale_revision">
                    <field string="Sale Revision" name="revision_count"
                           widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
