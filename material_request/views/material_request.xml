<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="material_list_view" model="ir.ui.view">
        <field name="name">material.list.view</field>
        <field name="model">material.request</field>
        <field name="arch" type="xml">
            <list string="Material Request list">
                <field name="requested_by"/>
                <field name="requested_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="material_form_view" model="ir.ui.view">
        <field name="name">material.form.view</field>
        <field name="model">material.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           options="{'clickable':1}"
                           statusbar_visible="draft,requested"/>
                    <button name="button_request" type="object"
                            string="Request Material" class="oe_highlight"
                            invisible="state!='draft'"
                            groups="material_request.group_requisition_users"/>
                    <button name="button_first_approval" type="object"
                            string="First Approval" class="oe_highlight"
                            invisible="state!='requested'"
                            groups="material_request.group_requisition_department_manager"/>
                    <button name="button_second_approval" type="object"
                            string="Second Approval" class="oe_highlight"
                            invisible="state!='first_approval'"
                            groups="material_request.group_requisition_head"/>
                    <button name="button_reject" type="object"
                            string="Reject Request" class="oe_highlight"
                            invisible="state!='first_approval'"
                            groups="material_request.group_requisition_head"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="requested_by"/>
                            <field name="requested_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="Material Information"
                              string="Material Information">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="requested_qty"/>
                                    <field name="request_type"/>
                                    <field name="vendor_id"
                                           widget="many2many_tags"
                                           invisible="request_type=='internal_transfer'"/>
                                    <field name="source_id"
                                           invisible="request_type=='purchase_order'"/>
                                    <field name="destination_id"
                                           invisible="request_type=='purchase_order'"/>
                                    <!--                                    <field name="operation_type"  invisible="request_type!='internal_transfer'"/>-->
                                </list>
                            </field>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="material_request_action" model="ir.actions.act_window">
        <field name="name">Material Request</field>
        <field name="res_model">material.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_noncontent_smiling_face">No Material Request Added!!</p>
        </field>
    </record>

</odoo>