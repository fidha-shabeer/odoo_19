<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="emp_loan_line_list" model="ir.ui.view">
        <field name="name">emp.loan.line.list</field>
        <field name="model">employee.loan.line</field>
        <field name="arch" type="xml">
            <list string="Loan List">
                <field name="loan_id"/>
                <field name="date"/>
                <field name="amount"/>
                <field name="paid"/>
            </list>
        </field>
    </record>

    <record id="emp_loan_line_form" model="ir.ui.view">
        <field name="name">emp.loan.line.form</field>
        <field name="model">employee.loan.line</field>
        <field name="arch" type="xml">
            <form string="Employee Loan">
                <sheet>
                    <group>
                        <field name="loan_id"/>
                        <field name="date"/>
                        <field name="amount"/>
                        <field name="paid"/>
                        <!--                                    <field name="credit_square"/>-->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_loan_line_menu" model="ir.actions.act_window">
        <field name="name">Employee Loan Line</field>
        <field name="res_model">employee.loan.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_noncontent_smiling_face">add new</p>
        </field>
    </record>
</odoo>