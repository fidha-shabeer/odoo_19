<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="emp_loan_list" model="ir.ui.view">
        <field name="name">emp.loan.list</field>
        <field name="model">employee.loan</field>
        <field name="arch" type="xml">
            <list string="Loan List">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="loan_amount"/>
                <field name="installment_count"/>
                <field name="start_date"/>
                <field name="state"/>
                <field name="installment_amount"/>
                <field name="total_payable"/>
            </list>
        </field>
    </record>

    <record id="emp_loan_form" model="ir.ui.view">
        <field name="name">emp.loan.form</field>
        <field name="model">employee.loan</field>
        <field name="arch" type="xml">
            <form string="Employee Loan">
                <header>
                    <field name="state" widget="statusbar"
                           options="{'clickable':1}"/>

                    <button name="action_approve" type="object"
                            string="Approve Loan"/>

                     <button name="action_pay" type="object"
                            string="Pay Installment"/>

                    <button name="action_generate" type="object"
                            string="Generate Installment" invisible="state!='approved'"/>

                    <div class="oe_button_box" name="button_box">
                                    <button name="action_smart_tab" type="object"
                                            class="oe_stat_button" icon="fa-book">
                                        <field name="loan_count" widget="statinfo" string="Loan Count"/>
                                    </button>
                    </div>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="employee_id"/>
                        <field name="loan_amount"/>
                        <field name="installment_count"/>
                        <field name="start_date"/>
                        <field name="installment_amount"/>
                        <field name="total_payable"/>
                        <field name="paid_amount"/>
                        <field name="balance_amount"/>
                        <!--                                    <field name="credit_square"/>-->
                    </group>
                    <notebook>
                        <page string="LOAN LINES">
                            <field name="loan_line_ids"/>
                            <!--                                            <p> Subscriptions are billed on a recurring basis</p>-->
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_loan_menu" model="ir.actions.act_window">
        <field name="name">Employee Loan</field>
        <field name="res_model">employee.loan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_noncontent_smiling_face">add new</p>
        </field>
    </record>
</odoo>