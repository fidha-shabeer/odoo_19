<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_approve_form" model="ir.ui.view">
        <field name="name">purchase.order.approve.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header/button[@name='button_confirm']" position="attributes">
                <attribute name="invisible">not is_activity_done or state =='purchase' or state =='draft'</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button string="Approve"
                        type="object" name="action_approve" class="btn btn-primary" invisible="state == 'approve_by_manager' or state == 'approve_by_director' or state == 'purchase'"/>
<!--                <button string="Approve by Manager"-->
<!--                        type="object" name="action_by_manager" class="btn btn-primary"-->
<!--                        groups="purchase.group_purchase_manager" invisible="state != 'approve_by_manager'"/>-->
<!--                <button string="Approve by Director"-->
<!--                        type="object" name="action_by_director" class="btn btn-primary"-->
<!--                        groups="auto_assign_approval_tier_by_po_amount.group_director_purchase"-->
<!--                        invisible="state != 'approve_by_director'"/>-->
            </xpath>
            <xpath expr="//field[@name='state']" position="inside">
                <field name="state" widget="statusbar"
                       statusbar_visible="draft,sent,approve_by_manager,approve_by_director,purchase,cancel"/>
            </xpath>
            <xpath expr="//field[@name='picking_type_id']" position="after">
                <field name="is_activity_done"/>
            </xpath>

        </field>
    </record>
</odoo>