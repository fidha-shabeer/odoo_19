<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mot_list_view" model="ir.ui.view">
        <field name="name">mot.list.view</field>
        <field name="model">mrp.production.ext</field>
        <field name="arch" type="xml">
            <list string="Mrp list">
                <field name="name"/>
                <field name="product_id"/>
                <field name="bom_id"/>
                <field name="quantity"/>
                <field name="planned_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="mot_form_view" model="ir.ui.view">
        <field name="name">mot.form.view</field>
        <field name="model">mrp.production.ext</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           options="{'clickable':1}"
                           statusbar_visible="draft,confirmed,cancel"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="bom_id"/>
                            <field name="quantity"/>
                            <field name="planned_date"/>
                            <field name="required_qty"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="Material Lines"
                              string="Material Lines">
                            <field name="material_line_ids">
                                <list editable="bottom">
                                    <field name="production_id"/>
                                    <field name="product_id"/>
                                    <field name="required_qty"/>
                                    <field name="available_qty"/>
                                    <field name="consumed_qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mrp_action" model="ir.actions.act_window">
        <field name="name">Mrp Production</field>
        <field name="res_model">mrp.production.ext</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_noncontent_smiling_face">No Mrp added!!</p>
        </field>
    </record>

</odoo>