<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="material_list_view" model="ir.ui.view">
        <field name="name">material.list.view</field>
        <field name="model">mrp.production.material.line</field>
        <field name="arch" type="xml">
            <list string="Material list">
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="required_qty"/>
                <field name="available_qty"/>
                <field name="consumed_qty"/>
            </list>
        </field>
    </record>

    <record id="material_form_view" model="ir.ui.view">
        <field name="name">material.form.view</field>
        <field name="model">mrp.production.material.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="production_id"/>
                            <field name="product_id"/>
                            <field name="required_qty"/>
                            <field name="available_qty"/>
                            <field name="consumed_qty"/>
                            <field name="is_material_available"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="material_action" model="ir.actions.act_window">
        <field name="name">Material Line</field>
        <field name="res_model">mrp.production.material.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_noncontent_smiling_face">No Line added!!</p>
        </field>
    </record>

</odoo>