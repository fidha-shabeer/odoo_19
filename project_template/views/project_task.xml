<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_form" model="ir.ui.view">
        <field name="name">view.project.task.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_task_template" type="object"
                        string="Create Task Template" class="btn btn-primary"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_task_template" type="object"
                            class="oe_stat_button" icon="fa-book" string="Task Template">
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>