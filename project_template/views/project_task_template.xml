<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="project_task_template_list" model="ir.ui.view">
        <field name="name">project.task.template.list.view</field>
        <field name="model">project.task.template</field>
        <field name="arch" type="xml">
            <list string="Project Template List">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="project_id"/>
            </list>
        </field>
    </record>

    <record id="project_task_template_form_views" model="ir.ui.view">
        <field name="name">project.template.form.views</field>
        <field name="model">project.task.template</field>
        <field name="arch" type="xml">
            <form string="form view">
                <header>
                    <button name="button_create_task" type="object" string="Create Task" class="btn btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_task" type="object"
                                class="oe_stat_button" icon="fa-book" string="Tasks">
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="project_id"/>
                    </group>
                    <notebook>
                        <page string="SubTask">
                            <group>
                                <field name="child_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="partner_id"/>
                                        <field name="project_id"/>
                                        <field name="parent_id"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="task_template_action" model="ir.actions.act_window">
        <field name="name">Task Template</field>
        <field name="res_model">project.task.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_noncontent_smiling_face">No project template added!!</p>
        </field>
    </record>

</odoo>