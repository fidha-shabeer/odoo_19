<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_project_form" model="ir.ui.view">
        <field name="name">view.project.project.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_project_template" type="object"
                        string="Create Project Template" class="btn btn-primary"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_project_template" type="object"
                            class="oe_stat_button" icon="fa-book" string="Project Template">
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>