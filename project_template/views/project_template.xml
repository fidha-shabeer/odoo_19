<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="project_template_list_view1" model="ir.ui.view">
        <field name="name">project.template.list.view1</field>
        <field name="model">project.template</field>
        <field name="arch" type="xml">
            <list string="Project Template List">
                <field name="name"/>
                <field name="partner_id"/>
            </list>
        </field>
    </record>

    <record id="project_template_form_view1" model="ir.ui.view">
        <field name="name">project.template.form.view1</field>
        <field name="model">project.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_project" type="object"
                            string="Create Project" class="btn btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_project" type="object"
                                class="oe_stat_button" icon="fa-book" string="Projects">
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                    </group>
                    <notebook>
                        <page string="Tasks">
                            <field name="task_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_template_action" model="ir.actions.act_window">
        <field name="name">Project Template</field>
        <field name="res_model">project.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_noncontent_smiling_face">No project template added!!</p>
        </field>
    </record>

</odoo>