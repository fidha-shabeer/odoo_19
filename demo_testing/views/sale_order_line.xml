<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record model="ir.ui.view" id="sale_order_check_view_inherit">
    <field name="name">sale.order.line.check.view.inherit1</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
<!--        field to sale order lines-->
        <xpath expr="/form/sheet/notebook/page/field[@name='order_line']/list/field[@name='tax_ids']" position="after">
            <field name="allowed_product" widget="many2many_tags"/>
        </xpath>
        <xpath expr="/form/sheet/notebook/page/field[@name='order_line']/list/field[@name='product_template_id']" position="attributes">
            <attribute name="domain">[('id','in',allowed_product)]</attribute>
        </xpath>
    </field>
</record>
</odoo>