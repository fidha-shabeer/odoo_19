<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bom_history" model="ir.ui.view">
        <field name="name">bom.history</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//form/sheet/div[@name='button_box']"
                   position="inside">
                <button class="oe_stat_button"
                        type="object"
                        icon="fa-book"
                        name="action_history">
                    <field string="BOM History" name="bom_history"
                           widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>