<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="bom_tracker_list_view" model="ir.ui.view">
            <field name="name">bom.tracker.list.view</field>
            <field name="model">bom.tracker</field>
            <field name="arch" type="xml">
                <list string="BOM Tracker list">
                    <field name="revision_number"/>
                    <field name="modified_by"/>
                    <field name="modified_on"/>
                    <field name="change_notes"/>
                </list>
            </field>
        </record>

        <record id="bom_tracker_form_view" model="ir.ui.view">
            <field name="name">bom.tracker.form.view</field>
            <field name="model">bom.tracker</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="revision_number"/>
                                <field name="modified_by"/>
                                <field name="modified_on"/>
                                <field name="change_notes"/>
                                <field name="bom_id"/>
                            </group>

                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>