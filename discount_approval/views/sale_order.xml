<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="sale_order_form_view" model="ir.ui.view">
       <field name="name">sale.order.form.view</field>
       <field name="model">sale.order</field>
       <field name="inherit_id" ref="sale.view_order_form"/>
       <field name="arch" type="xml">
           <xpath expr="//field[@name='state']" position="inside">
               <field name="state" widget="statusbar" statusbar_visible="draft,sent,sale"/>
           </xpath>

           <xpath expr="//header" position="inside">
               <button name="action_approve" string="Approve" type="object" class="oe_highlight" groups="sales_team.group_sale_manager" invisible="state != 'approval_pending'"/>
           </xpath>

           <xpath expr="//header" position="inside">
               <button name="action_reject" string="reject" type="object" class="oe_highlight" groups="sales_team.group_sale_manager" invisible="state != 'approval_pending'"/>
           </xpath>
       </field>
   </record>
</odoo>