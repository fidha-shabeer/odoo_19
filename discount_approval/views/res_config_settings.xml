<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <!-- Sale Config Settings Inherit -->
   <record id="res_config_settings_view_form_inherit_discount_approval" model="ir.ui.view">
       <field name="name">res.config.settings.view.form.inherit.discount.approval</field>
       <field name="model">res.config.settings</field>
       <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
       <field name="arch" type="xml">
<!--           <xpath expr="//app[@name='sale_management']" position="inside">-->
                <xpath expr="//setting[@id='discount_sale_order_lines']" position="after">
<!--               <block title="Discount Limit">-->
                   <setting string="Discount Limit" help="Enable to add the discount limit">
                       <field name="is_discount_limit"/>
                       <field name="discount_limit" invisible="not is_discount_limit"/>
                   </setting>
<!--               </block>-->
           </xpath>
       </field>
   </record>
</odoo>