<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="view_credit_limit_partner" model="ir.ui.view">
       <field name="name">view.credit.limit.partner</field>
       <field name="model">res.partner</field>
       <field name="inherit_id" ref="base.view_partner_form"/>
       <field name="arch" type="xml">
           <xpath expr="//field[@name='invoice_sending_method']" position="after">
               <field name="credit"/>
               <field name="sales_outstanding"/>
               <field name="partner_limit"/>
           </xpath>
       </field>
   </record>
</odoo>