<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Config Settings Inherit -->
    <record id="res_config_settings_view_form_inherit_mandatory_attachment"
            model="ir.ui.view">
        <field name="name">
            res.config.settings.view.form.inherit.mandatory.attachment
        </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']/block[@name='purchase_setting_container']" position="after">
                <block title="Mandatory Attachment">
                    <setting string="Attachment required before purchase order">
                        <field name="is_required_attachment"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>